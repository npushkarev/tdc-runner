# Несекретные значения по умолчанию (в git). Локальные переопределения —
# .env.local (не коммитится), в CI — переменные конфигурации.
# Из .env.example репо остались только те, что не выводятся из топологии
# compose: POSTGRES_HOST/PORT и BACKEND_HOST/PORT задаются именами сервисов.
POSTGRES_USER=test
POSTGRES_PASSWORD=test
READ_DB=openide_read
WRITE_DB=openide
TESTS_IMAGE_TAG=1.0.0
