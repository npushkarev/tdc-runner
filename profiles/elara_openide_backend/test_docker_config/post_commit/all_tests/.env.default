# Значения по умолчанию. Файл лежит в git, поэтому настоящих паролей и ключей
# здесь быть не должно (тестовые заглушки test/test — можно).
# Локальные переопределения — .env.local рядом, он не коммитится.
#
# Из вашего .env.example остались только те переменные, что не выводятся из
# самого compose: POSTGRES_HOST/PORT и BACKEND_HOST/PORT задаются именами
# сервисов. Заодно исчезает расхождение с инструкцией: в .env.example стоит
# POSTGRES_HOST=localhost, а для запуска в докере нужен postgres.
POSTGRES_USER=test
POSTGRES_PASSWORD=test
READ_DB=openide_read
WRITE_DB=openide

# Образ с тестами. ЗАМЕНИТЬ your-feed на фид ProGet, куда он публикуется:
# первым сегментом имени ProGet требует реальный фид, иначе не резолвится.
# Имя отличается от postgres-набора: там образ из одного проекта, здесь из
# всего решения.
TESTS_IMAGE=proget.inc.elara.local/your-feed/openide-all-tests:1.0.0

# База. Тот же реестр, тег иммутабельный.
POSTGRES_IMAGE=proget.inc.elara.local/main/library/postgres:18.1
